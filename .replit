modules = ["nodejs-20", "web"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 15173
externalPort = 80

[[ports]]
localPort = 15174
externalPort = 3000

[[ports]]
localPort = 18180
externalPort = 3001
exposeLocalhost = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "trap 'kill 0' EXIT INT TERM; PORT=8080 pnpm --filter @workspace/api-server run dev & WEB_PORT=5000 API_URL=http://127.0.0.1:8080 pnpm --filter @workspace/github-automation-dashboard run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
